  "principles": [
    {
      "id": "max_five",
      "page": 324,
      "rule": "양초형은 1개~최대 5개 양초의 조합. 대부분 반전형, 일부 지속형"
    },
    {
      "id": "mirror_pairs",
      "page": 324,
      "rule": "상승 패턴의 반대 모양 = 하락 패턴. 보통 같은 이름을 쓰지만 다른 이름인 경우도 있음 (흑운↔관통형)"
    },
    {
      "id": "trend_prerequisite",
      "page": [
        324,
        325
      ],
      "rule": "반전형은 직전 추세가 전제다. 상승추세에서 나온 상승형 모양은 상승반전형이 아니다. 먼저 단기(약 10기간) 추세를 이동평균 등으로 판정할 것",
      "code": "trend = close > SMA(10) 그리고 SMA(10) 기울기 (보충)"
    },
    {
      "id": "strict_for_computer",
      "page": [
        326,
        327
      ],
      "rule": "사람은 완전히 일치하지 않는 패턴도 인정하지만, 컴퓨터는 명확한 수치 조건이 필요하고 주관적 해석을 허용하지 않는다"
    },
    {
      "id": "pixel_illusion",
      "page": 329,
      "rule": "변동폭이 큰 데이터를 화면으로 보면 픽셀 해상도 때문에 도지처럼 보이는 착시가 생긴다 → 눈이 아니라 수학적 조건으로 판별"
    },
    {
      "id": "continuation_usefulness",
      "page": 327,
      "rule": "지속형은 포지션을 유지할지 정리할지 판단하는 데 유용. 일본 문헌은 반전형 약 40개, 지속형 16개를 다룸"
    }
  ],
  "filtered_candles": {
    "id": "filtered_candle_patterns",
    "developer": "그레그 모리스, 1991",
    "page": [
      329,
      330
    ],
    "def_source": "book",
    "rules": [
      "반전 양초형은 오실레이터가 '신호 예정 영역'에 있을 때만 채택",
      "예: 스토캐스틱 %D > 80 (하락반전만) 또는 < 20 (상승반전만). %D=65에서 나온 패턴은 무시",
      "반전형에만 적용",
      "RSI, CCI, Williams %R로도 대체 가능"
    ],
    "stoch_signal": "%D가 80 위로 올라갔다가 80 아래로 내려오면 매도, 20 아래로 내려갔다가 20 위로 올라오면 매수",
    "code": "accept = (dir=='bull' && D<=20) || (dir=='bear' && D>=80)",
    "app_note": "패턴 탐지기에 '필터 ON/OFF' 토글 → 필터 전·후 적중률을 비교 학습 (핵심 교육 기능)",
    "link": "indicators.json → stochastic"
  },
